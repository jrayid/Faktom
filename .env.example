RESEND_API_KEY=re_your_api_key
CONTACT_TO_EMAIL=team@example.com
CONTACT_FROM_EMAIL="Fakom International <noreply@example.com>"
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# set to the real domain before launch
SITE_URL=https://www.example.com
# Vercel overwrites this header; other proxies must do the same to prevent spoofing.
CLIENT_IP_HEADER=x-forwarded-for
# Production must point this at a durable, writable mounted volume.
CONTACT_SUBMISSIONS_PATH=
